# stream-eval configuration

# Agent adapter: claude, codex, or opencode
STREAM_EVAL_AGENT=claude

# Model identifier accepted by the selected adapter
# Unset uses sonnet for Claude and the CLI default for Codex
# OpenCode uses its backend default unless profile=inherit loads user config
# STREAM_EVAL_MODEL=

# Optional adapter-specific reasoning effort
# Claude receives --effort, Codex receives model_reasoning_effort,
# and OpenCode receives --variant
# STREAM_EVAL_EFFORT=

# Spawn isolation: isolated, restricted, or inherit
STREAM_EVAL_PROFILE=isolated

# Optional agent-neutral state directory and dashboard session label
# STREAM_EVAL_STATE_DIR=
# STREAM_EVAL_SESSION_ID=

# Dashboard file and row caps
STREAM_EVAL_OUTPUT_LIMIT=100
STREAM_EVAL_PER_SKILL_CAP=5

# Dashboard poll intervals in milliseconds
STREAM_EVAL_POLL_ACTIVE_MS=5000
STREAM_EVAL_POLL_IDLE_MS=30000
