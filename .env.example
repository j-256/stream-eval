# stream-eval configuration. Copy to .env locally; .env is gitignored.

# Model identifier for `claude -p --model`. Pin an exact identifier
# (e.g. claude-sonnet-4-6) rather than the `sonnet` alias if your CLI's
# alias resolution doesn't target the version you want -- some
# deployments resolve `sonnet` to an older release.
STREAM_EVAL_MODEL=sonnet

# Dashboard last-N file walk caps. Tunable upward for very busy
# operator setups; downward to limit psutil/IO overhead on hosts with
# thousands of historical .output files.
STREAM_EVAL_OUTPUT_LIMIT=100
STREAM_EVAL_PER_SKILL_CAP=5
